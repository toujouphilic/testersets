DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Local default is ./data. Render's render.yaml sets this to /var/data.
DATA_DIR=./data

# Optional live Epaxial chat logger (separate Twitch user OAuth token)
TWITCH_CHAT_BOT_USERNAME=your_twitch_login
TWITCH_CHAT_OAUTH_TOKEN=your_twitch_user_access_token
# Custom Discord emoji syntax: <:vip:123456789012345678>
CHATLOG_VIP_EMOJI=
CHATLOG_PARTNER_EMOJI=
CHATLOG_USERNAME=epaxial
